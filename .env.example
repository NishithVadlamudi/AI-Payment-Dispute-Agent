# Server-only. Never prefix these credentials with NEXT_PUBLIC_.
# For local Supabase, get these from `npx supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Only used by the database integration test to verify anonymous access is denied.
SUPABASE_ANON_KEY=
AI_PROVIDER=gemini
GEMINI_API_KEY=
# The existing cloud binding AI_Payment_Dispute_Agent_Key is also accepted.
# Validated with the three live demo scenarios; check free-tier eligibility in AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite
# OpenAI is opt-in only; it is never an automatic fallback.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# Cloud environments reserve OPENAI_ secret targets. This alias is also supported.
# DISPUTE_OPENAI_API_KEY=
# Phase 3: conservative accounting allowances, NOT current provider prices.
# All amounts are integers. 1,000,000 micro-USD = $1.
# Check actual provider rates; these allowances must upper-bound them.
AI_DAILY_BUDGET_MICROUSD=5000000
# 1 micro-USD/token = $1 per million tokens. Defaults allow $5 input/$20 output per million.
AI_INPUT_MICROUSD_PER_TOKEN=5
AI_OUTPUT_MICROUSD_PER_TOKEN=20
# Changing provider/model requires an explicit matching budget configuration.
AI_BUDGET_PROVIDER=gemini
AI_BUDGET_MODEL=gemini-3.5-flash-lite
AI_REQUESTS_PER_MINUTE=10
# Only enable behind a proxy that STRIPS untrusted forwarding headers.
# Vercel forwarding headers are used automatically when VERCEL=1.
# Otherwise requests share a conservative local bucket.
TRUST_PROXY_HEADERS=false

# Alternative to hosted Supabase: private PostgREST / Render + Neon.
# Render supplies DATABASE_URL privately and generates PGRST_JWT_SECRET.
# Startup creates the loopback-only API and its server-only token automatically.
# DATABASE_URL=postgresql://owner:password@your-neon-host/database?sslmode=require
# PGRST_JWT_SECRET=use-a-private-random-value-at-least-32-characters
# For an already-running PostgREST server, these take priority over Supabase aliases:
# POSTGREST_URL=http://127.0.0.1:3001
# POSTGREST_SERVICE_KEY=
